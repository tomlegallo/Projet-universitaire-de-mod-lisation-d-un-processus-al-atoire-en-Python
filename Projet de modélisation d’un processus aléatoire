    "def seuil_montees (nb_individu_total,nb_places_telesiege,proba):\n",
    "    \"\"\"\n",
    "    Retourne le nombre de telesiege necessaire afin de revoir une personne avec une certaine probabilite\n",
    "    \"\"\"\n",
    "    return np.sqrt(2*nb_individu_total*np.log(1/(1-proba)))/(nb_places_telesiege-1)"
   ]
