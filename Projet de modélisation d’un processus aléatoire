    "def proba_theorique (nb_individu_total,nb_place_telesiege,k):\n",
    "    return np.exp(-((nb_place_telesiege-1)**2 / (2*nb_individu_total)) * k**2) #Formule determiné dans notre etude\n",
    "\n",
    "def proba_empirique (nb_individu_total,nb_place_telesiege,nb_tentative,k): #Probabilite determiné empiriquement\n",
    "    \n",
    "    res_telesiege=nb_telesiege_avant_premiere_rencontre(nb_individu_total,nb_place_telesiege,nb_tentative)\n",
    "    resultat=[]\n",
    "    for element in k:\n",
    "        resultat.append(np.mean(res_telesiege > element))\n",
    "    return resultat\n",
    "    "
   ]
