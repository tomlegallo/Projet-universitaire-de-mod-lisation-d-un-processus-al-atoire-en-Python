  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e2e9685d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def Esperance_T (nb_individu_total, nb_place_telesiege, nb_tentative):\n",
    "\n",
    "        \"\"\"\n",
    "        Permet d'estimer numeriquement l'esperance de T\n",
    "        \"\"\"\n",
    "\n",
    "        res_tentative=[]\n",
    "        for _ in range (nb_tentative):\n",
    "                test=True\n",
    "                nb_telesiege=0\n",
    "                ensemble_rencontre=set()\n",
    "\n",
    "                while test:\n",
    "                        rencontre=np.random.choice(nb_individu_total, size=nb_place_telesiege-1, replace=False)\n",
    "                        nb_telesiege+=1\n",
    "\n",
    "                        for element in rencontre:\n",
    "\n",
    "                                if element not in ensemble_rencontre:\n",
    "                                        ensemble_rencontre.add(element)\n",
    "\n",
    "                                else :\n",
    "                                        test=False\n",
    "                                        res_tentative.append(nb_telesiege)\n",
    "                                        break\n",
    "\n",
    "        return(np.mean(res_tentative))"
   ]
