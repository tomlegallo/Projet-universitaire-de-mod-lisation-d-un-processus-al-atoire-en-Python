   "source": [
    "def proba_doublon (nb_individu_total,nb_places_telesiege,nb_montees):\n",
    "    \"\"\"\n",
    "    Retourne la probabilites de P(T<=K) autrement dit la probabilites de revoir une personne en fonction du nombre de montees (Pour un type de teklesiege et une population donnee)\n",
    "    \"\"\"\n",
    "    return 1 - np.exp(-((nb_places_telesiege - 1)**2 / (2 * nb_individu_total)) * nb_montees**2)"
   ]
